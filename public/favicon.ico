<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <!-- Premium Dark Crimson & Gold Badge -->
  <rect width="64" height="64" rx="14" fill="#240205"/>
  <rect x="2" y="2" width="60" height="60" rx="12" fill="none" stroke="#FACC15" stroke-width="2.5" opacity="0.85"/>
  
  <!-- Sleek Luxury Car Silhouette -->
  <!-- Cabin Windows -->
  <path d="M22 26 L27 18 H39 L47 26 Z" fill="#FDE047" fill-opacity="0.3" stroke="#FACC15" stroke-width="1.8" stroke-linejoin="round"/>
  <line x1="34" y1="18" x2="34" y2="26" stroke="#FACC15" stroke-width="1.8"/>
  
  <!-- Car Body Profile -->
  <path d="M10 33 C10 30, 16 28, 22 26 L47 26 C51 28, 54 29, 54 32 L54 37 C54 37.5, 52 38, 50 38 C49.5 35, 47 33, 44 33 C41 33, 38.5 35, 38 38 L28 38 C27.5 35, 25 33, 22 33 C19 33, 16.5 35, 16 38 L11 38 C10 38, 10 36, 10 33 Z" fill="#FACC15"/>
  
  <!-- LED Headlight in Crisp White -->
  <polygon points="10,32 15,31 14,34 10,34" fill="#FFFFFF"/>
  <!-- Taillight in Amber Gold -->
  <rect x="52" y="31" width="2" height="3" rx="0.5" fill="#EF4444"/>

  <!-- Wheels (Tires & Gold Alloy Rims) -->
  <circle cx="22" cy="38" r="5.5" fill="#180103" stroke="#FACC15" stroke-width="2"/>
  <circle cx="22" cy="38" r="2" fill="#FACC15"/>

  <circle cx="44" cy="38" r="5.5" fill="#180103" stroke="#FACC15" stroke-width="2"/>
  <circle cx="44" cy="38" r="2" fill="#FACC15"/>

  <!-- Dynamic Road / Speed Line -->
  <line x1="12" y1="47" x2="52" y2="47" stroke="#FACC15" stroke-width="1.8" stroke-linecap="round" opacity="0.65"/>
  <line x1="6" y1="47" x2="9" y2="47" stroke="#FACC15" stroke-width="1.8" stroke-linecap="round" opacity="0.4"/>
</svg>
